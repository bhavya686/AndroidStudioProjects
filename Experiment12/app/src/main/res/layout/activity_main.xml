<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6FA"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Web Service Explorer"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#173B67"
        android:gravity="center"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HTTP Request Demonstration"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/tvStudentDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name: Bhavya Khatri | USN: 25MCAR0217"
        android:textSize="14sp"
        android:textColor="#333333"
        android:gravity="center"
        android:padding="14dp"
        android:layout_marginTop="20dp"
        android:background="#FFFFFF" />

    <Button
        android:id="@+id/btnFetch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fetch Data from Server"
        android:textAllCaps="false"
        android:layout_marginTop="22dp"
        android:backgroundTint="#2463A6" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server Response"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#173B67"
        android:layout_marginTop="25dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap the button to send an HTTP GET request."
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginTop="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No data received yet."
            android:textSize="15sp"
            android:textColor="#222222"
            android:textIsSelectable="true" />

    </ScrollView>

</LinearLayout>