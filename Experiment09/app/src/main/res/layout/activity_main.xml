<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Student Notes"
            android:textColor="#1B2B55"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Save your preferences and notes locally"
            android:textColor="#667085"
            android:textSize="14sp" />

        <!-- SharedPreferences section -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Preferences"
            android:textColor="#1B2B55"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/studentNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Enter student name"
            android:inputType="textPersonName"
            android:minHeight="52dp"
            android:padding="12dp"
            android:textColor="#1B2B55"
            android:textColorHint="#7A8499" />

        <CheckBox
            android:id="@+id/darkModeCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable dark theme preference"
            android:textColor="#344054"
            android:textSize="15sp" />

        <Button
            android:id="@+id/savePreferencesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Save Preferences"
            android:textAllCaps="false"
            android:backgroundTint="#6750A4"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:background="#D0D5DD" />

        <!-- SQLite notes section -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create a Note"
            android:textColor="#1B2B55"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/noteTitleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Note title"
            android:inputType="textCapSentences"
            android:minHeight="52dp"
            android:padding="12dp"
            android:textColor="#1B2B55"
            android:textColorHint="#7A8499" />

        <EditText
            android:id="@+id/noteContentInput"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="top|start"
            android:hint="Write your note here..."
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp"
            android:textColor="#1B2B55"
            android:textColorHint="#7A8499" />

        <Button
            android:id="@+id/saveNoteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save Note"
            android:textAllCaps="false"
            android:backgroundTint="#6750A4"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="Saved Notes"
            android:textColor="#1B2B55"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emptyNotesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="No notes saved yet."
            android:textColor="#667085"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/notesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>