<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contacts Content Provider"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bhavya Khatri | 25MCAR0217"
            android:textSize="16sp"
            android:textColor="#444444"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/btnLoadContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load Contacts" />

        <TextView
            android:id="@+id/tvContactCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contacts will appear below."
            android:textSize="16sp"
            android:textColor="#202124"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#202124"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:text="No contacts loaded yet." />

    </LinearLayout>
</ScrollView>